{
  "gateway": {
    "host": "127.0.0.1",
    "port": 18082,
    "log_level": "info"
  },
  "watch_config": true,
  "config_poll_interval_seconds": 2,
  "drain_timeout_seconds": 300,
  "lifecycle_log_dir": "logs/lifecycle",
  "admission_enabled": true,
  "admission_timeout_seconds": 900,
  "health": {
    "enabled": true,
    "interval_seconds": 2,
    "probe_timeout_seconds": 2,
    "failure_threshold": 3,
    "recovery_threshold": 2
  },
  "admission": {
    "prompt": "What is 17 + 25? Reply with the number only.",
    "expected": "42",
    "max_tokens": 32,
    "temperature": 0,
    "enable_thinking": false,
    "poll_interval_seconds": 1
  },
  "timeout_seconds": 120,
  "max_connections": 256,
  "default_max_tokens": 128,
  "default_enable_thinking": false,
  "admin_token_env": "MOQE_ADMIN_TOKEN",
  "router": null,
  "nodes": [
    {
      "id": "npu-209",
      "host": "10.107.206.209",
      "ssh_target": "root@10.107.206.209",
      "container": "moqe-loss-expert",
      "enabled": true
    },
    {
      "id": "npu-212-cold",
      "host": "10.107.206.212",
      "ssh_target": "root@10.107.206.212",
      "container": "moqe-cold-node-test",
      "prepare": {
        "python": "python3",
        "required_modules": ["vllm", "torch_npu"],
        "host_checks": [["npu-smi", "info"]],
        "required_paths": ["/workspace/zhangjinhao/moqe-runtime/adapter", "/workspace/zhangjinhao/runtime"],
        "env": {"ASCEND_RT_VISIBLE_DEVICES": "3"},
        "environment_scripts": ["/usr/local/Ascend/ascend-toolkit/set_env.sh", "/usr/local/Ascend/nnal/atb/set_env.sh"],
        "helper_path": "/workspace/zhangjinhao/moqe-managed/manage_backend.py",
        "command_timeout_seconds": 120
      },
      "enabled": false
    }
  ],
  "replicas": [
    {
      "id": "awq-209-card0",
      "expert": "awq",
      "enabled": true,
      "node_id": "npu-209",
      "device_ids": [
        0
      ],
      "base_url": "http://10.107.206.209:19000/v1",
      "backend_port": 19000,
      "model": "moqe-qwen3-awq",
      "model_path": "/workspace/zhangjinhao/model/Qwen3-14B-AWQ-Ascend-INT4",
      "launch": null
    },
    {
      "id": "awq-212-cold-card3",
      "expert": "awq",
      "enabled": true,
      "node_id": "npu-212-cold",
      "device_ids": [
        3
      ],
      "base_url": "http://10.107.206.212:19103/v1",
      "backend_port": 19103,
      "model": "moqe-qwen3-awq",
      "model_path": "/workspace/zhangjinhao/model/Qwen3-14B-AWQ-Ascend-INT4",
      "launch": {
        "stop_command": [
          "python3",
          "{backend_helper}",
          "stop",
          "--pid-file",
          "/workspace/zhangjinhao/run/{id}.json",
          "--stop-timeout",
          "60"
        ],
        "env": {
          "VLLM_USE_V1": "1",
          "VLLM_NO_USAGE_STATS": "1",
          "ASCEND_RT_VISIBLE_DEVICES": "{device_ids}",
          "VLLM_VERSION": "0.8.4",
          "OMP_NUM_THREADS": "4",
          "PYTHONPATH": "/workspace/zhangjinhao/runtime:/workspace/zhangjinhao/moqe-runtime/adapter:/workspace/zhangjinhao/moqe-runtime/python-deps:/workspace/vllm:/workspace/vllm-ascend",
          "MOQE_ASCEND_INT4_ADAPTER": "1"
        },
        "command_timeout_seconds": 60,
        "vllm_args": {
          "quantization": "moqe_ascend_int4",
          "tensor_parallel_size": 1,
          "dtype": "float16",
          "max_model_len": 12288,
          "max_num_seqs": 8,
          "gpu_memory_utilization": 0.5,
          "max_num_batched_tokens": 2048,
          "enable_chunked_prefill": true,
          "enable_prefix_caching": false,
          "enforce_eager": true,
          "disable_frontend_multiprocessing": true,
          "disable_log_requests": true
        },
        "start_command": [
          "python3", "{backend_helper}", "start",
          "--pid-file", "/workspace/zhangjinhao/run/{id}.json",
          "--log-file", "/workspace/zhangjinhao/logs/{id}.log",
          "--", "python3", "-m", "vllm.entrypoints.openai.api_server",
          "--model", "{model_path}", "--served-model-name", "{model}",
          "--host", "0.0.0.0", "--port", "{port}", "{vllm_args}"
        ]
      }
    }
  ]
}
